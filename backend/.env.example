# Copia este archivo como .env (PowerShell: Copy-Item .env.example .env) y llena los valores.
NODE_ENV=development
PORT=4000

# Local con Docker:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/portafolio
# Producción (Neon): postgres://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/portafolio?sslmode=require

# Dominios que pueden llamar a la API (separados por coma)
CORS_ORIGIN=http://localhost:5173

# GitHub (el token es opcional; sin token el límite es 60 consultas/hora)
GITHUB_USER=rubentorres-dev
GITHUB_TOKEN=

# Aviso por correo (Gmail + "contraseña de aplicación"). Déjalos vacíos si aún no lo configuras.
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=rt633659@gmail.com

# Cloudflare Turnstile (anti-bots). Clave secreta de PRUEBA que siempre aprueba.
# En producción usa la tuya (dash.cloudflare.com → Turnstile). Vacía = verificación desactivada.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Aviso por Telegram de cada mensaje del formulario (gratis, API oficial). Pasos en GUIA_PASO_A_PASO.md.
# El token lo da @BotFather; el chat id lo muestra: npm run telegram:id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Aviso por WhatsApp con Whapi.Cloud (plan Sandbox, gratis). Token en panel.whapi.cloud → tu canal.
WHAPI_TOKEN=
# Número que recibe el aviso, con indicativo y sin "+"
WHAPI_DESTINO=573245374597
# Para cuidar tu número: máximo de avisos por día y minutos mínimos entre avisos
WHAPI_MAX_DIA=5
WHAPI_MINUTOS=2

# Máximo de mensajes del formulario por hora, sumando a todos los visitantes
CONTACTO_MAX_HORA=15
