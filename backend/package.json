{
  "name": "portafolio-backend",
  "version": "1.0.0",
  "description": "API REST del portafolio de Rubén Torres Osorio (Express + PostgreSQL, arquitectura MVC)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "jest --runInBand",
    "telegram:id": "node scripts/telegram-chat-id.js",
    "whatsapp:probar": "node scripts/whatsapp-probar.js",
    "consentimientos": "node scripts/consentimientos.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.22.3",
    "express-rate-limit": "7.4.1",
    "helmet": "7.1.0",
    "nodemailer": "10.0.12",
    "pg": "8.13.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "supertest": "7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ]
  }
}
