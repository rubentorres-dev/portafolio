# Copia este archivo como .env (PowerShell: Copy-Item .env.example .env)
# Variables VITE_ son PÚBLICAS (quedan dentro del sitio). Nunca pongas aquí contraseñas ni llaves secretas.

# URL del backend. En local: http://localhost:4000 · En producción: la URL de Render.
VITE_API_URL=http://localhost:4000

# Dominio público del sitio (para SEO y URLs canónicas)
VITE_SITE_URL=https://rubentorres-dev.vercel.app

# Cloudflare Turnstile (anti-bots). Clave de PRUEBA que siempre aprueba; en producción usa la tuya.
# Déjala vacía para desactivar la verificación.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
